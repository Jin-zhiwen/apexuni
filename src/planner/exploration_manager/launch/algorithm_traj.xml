<launch>
    <arg name="map_size_x_"/>
    <arg name="map_size_y_"/>

    <arg name="odometry_topic_"/>
    <arg name="sensor_pose_topic_"/>
    <arg name="depth_topic_"/>

    <arg name="cx_"/>
    <arg name="cy_"/>
    <arg name="fx_"/>
    <arg name="fy_"/>
    <arg name="camera_height_" default="0.43"/>
    <arg name="obstacle_min_above_floor_" default="0.15"/>
    <arg name="obstacle_max_above_floor_" default="0.90"/>
    <arg name="depth_min_dist_" default="0.20"/>
    <arg name="depth_max_dist_" default="3.00"/>
    <arg name="obstacles_inflation_" default="0.06"/>
    
    <!-- Real-world mode flag (default to false for simulation) -->
    <arg name="is_real_world_" default="false"/>

    <!-- main node -->
    <node pkg="exploration_manager" name="exploration_node" type="exploration_node" output="screen">
        <!-- Load trajectory planning parameters for real-world mode -->
        <rosparam file="$(find trajectory_manager)/config/planning_param.yaml" command="load" />

        <remap from ="/odom_world"    to = "$(arg odometry_topic_)"/>
        <remap from ="/map_ros/pose"  to = "$(arg sensor_pose_topic_)"/>
        <remap from ="/map_ros/depth" to = "$(arg depth_topic_)"/>

        <!-- FSM mode selection -->
        <param name="is_real_world" value="$(arg is_real_world_)" type="bool"/>

        <!-- Mapping -->
        <!-- ray_mode = 1 casts from sensor to depth endpoint and stops at current obstacles.
             This is safer for real-world depth because all-depth free-space raycasts can
             otherwise clear cells behind walls through invalid/reflective depth returns. -->
        <param name="sdf_map/ray_mode" value="1" />
        <param name="sdf_map/resolution" value="0.05" />
        <param name="sdf_map/map_size_x" value="$(arg map_size_x_)" />
        <param name="sdf_map/map_size_y" value="$(arg map_size_y_)" />
        <param name="sdf_map/obstacles_inflation" value="$(arg obstacles_inflation_)" />
        <param name="sdf_map/local_bound" value="5.0"/>

        <param name="sdf_map/p_hit" value="0.70"/>
        <param name="sdf_map/p_miss" value="0.35"/>
        <param name="sdf_map/p_min" value="0.10"/>
        <param name="sdf_map/p_max" value="0.98"/>
        <param name="sdf_map/p_occ" value="0.80"/>
        <param name="sdf_map/max_ray_length" value="$(arg depth_max_dist_)"/>
        <param name="sdf_map/ray_stop_dilation" value="1"/>
        <param name="sdf_map/optimistic" value="false" type="bool"/>
        <param name="sdf_map/signed_dist" value="false" type="bool"/>

        <param name="map_ros/cx" value="$(arg cx_)"/>
        <param name="map_ros/cy" value="$(arg cy_)"/>
        <param name="map_ros/fx" value="$(arg fx_)"/>
        <param name="map_ros/fy" value="$(arg fy_)"/>
        <param name="map_ros/depth_filter_maxdist" value="$(arg depth_max_dist_)"/>
        <param name="map_ros/depth_filter_mindist" value="$(arg depth_min_dist_)"/>
        <!-- D435i border pixels are noisier, especially when the camera is mounted
             high and looking down toward nearby floor/door thresholds. -->
        <param name="map_ros/depth_filter_margin" value="8"/>
        <!-- For real-world VIO, odom z may drift from the startup camera height.
             Keep obstacle limits in "meters above the local floor" and let MapROS
             estimate floor_z = camera_z - camera_height for each depth frame. -->
        <param name="map_ros/use_camera_height_filter" value="true" type="bool"/>
        <param name="map_ros/camera_height" value="$(arg camera_height_)"/>
        <param name="map_ros/filter_min_height" value="$(arg obstacle_min_above_floor_)"/>
        <param name="map_ros/filter_max_height" value="$(arg obstacle_max_above_floor_)"/>
        <!-- RealSense D435i depth is typically TYPE_16UC1 in millimeters. -->
        <param name="map_ros/k_depth_scaling_factor" value="1000.0"/>
        <param name="map_ros/depth_is_normalized" value="false"/>
        <param name="map_ros/depth_unit_scale" value="0.001"/>
        <param name="map_ros/skip_pixel" value="1"/>
        <!-- Dual-machine ROS setup benefits from a less aggressive sync window. -->
        <param name="map_ros/sync_slop" value="0.05"/>
        <param name="map_ros/max_pose_depth_dt" value="0.05"/>
        <param name="map_ros/frame_id" value="odom"/>
        <param name="map_ros/virtual_ground_height" value="$(eval -float(arg('camera_height_')))"/>

        <param name="fsm/replan_time" value="0.30" type="double"/>
        <param name="fsm/replan_traj_end_threshold" value="1.0" type="double"/>
        <param name="fsm/replan_frontier_change_delay" value="3.5" type="double"/>
        <param name="fsm/replan_timeout" value="4.0" type="double"/>
        <param name="fsm/tracking_abort_distance" value="0.65" type="double"/>
        <param name="fsm/visualize_objects" value="false" type="bool"/>

        <!-- Exploration manager -->
        <!-- 0: distance 1: semantic 2: hybrid(TSP sem + closest dist) 3: TSP(distance) -->
        <param name="exploration/policy" value="2" type="int"/>
        <param name="exploration/sigma_threshold" value="0.015" type="double"/>
        <param name="exploration/max_to_mean_threshold" value="1.10" type="double"/>
        <param name="exploration/max_to_mean_percentage" value="0.90" type="double"/>
        <param name="exploration/tsp_dir" value="$(find lkh_mtsp_solver)/resource" type="string"/>

        <param name="frontier/cluster_min" value="5" type="int"/>
        <param name="frontier/cluster_size_xy" value="0.65" type="double"/>
        <param name="frontier/min_view_finish_fraction" value="0.2" type="double"/>
        <param name="frontier/min_contain_unknown" value="30" type="int"/>

        <param name="object/min_observation_num" value="2" type="int"/>
        <!-- 0: no_fusion 1: ours_fusion 2: max_fusion-->
        <param name="object/fusion_type" value="1" type="int"/>
        <param name="object/use_observation" value="true" type="bool"/>
        <param name="object/vis_cloud" value="false" type="bool"/>

        <!-- Perception utils -->
        <param name="perception_utils/left_angle" value="$(eval 30 * 3.1415926 / 180.0)" type="double"/>
        <param name="perception_utils/right_angle" value="$(eval 30 * 3.1415926 / 180.0)" type="double"/>
        <param name="perception_utils/max_dist" value="4.0" type="double"/>
        <param name="perception_utils/vis_dist" value="1.0" type="double"/>

        <!-- path searching -->
        <param name="astar/lambda_heu" value="1.0" type="double"/>
        <param name="astar/resolution_astar" value="0.1" type="double"/>
        <param name="astar/preferred_clearance" value="0.25" type="double"/>
        <param name="astar/wall_penalty_weight" value="3.0" type="double"/>
        <param name="kinoastar/unknown_as_collision" value="false" type="bool"/>
    </node>

    <!-- ATSP solver -->
    <node pkg="lkh_mtsp_solver" name="tsp_solver" type="tsp_node" output="log">
        <param name="exploration/tsp_dir" value="$(find lkh_mtsp_solver)/resource" type="string"/>
    </node>
</launch>
