<launch>
  <!-- size of map, change the size in x, y according to your application -->
  <arg name="map_size_x" value="80.0"/>
  <arg name="map_size_y" value="80.0"/>

  <!-- Real-world mode flag -->
  <arg name="is_real_world" default="false"/>

  <!-- Parameter yaml loaded into ROS param server for planner/map_ros -->
  <arg name="eval_config" default="habitat_eval_hm3dv2.yaml"/>

  <!-- topic of your odometry such as VIO or LIO -->
  <arg name="odom_topic" value="/habitat/odom" />
  <!-- transform of camera frame in the world frame -->
  <arg name="sensor_pose_topic" value="/habitat/sensor_pose"/>
  <!-- depth image, 640x480 by default -->
  <arg name="depth_topic" value="/habitat/camera_depth"/>

  <!-- map_ros filter params (task-dependent) -->
  <arg name="filter_min_height" default="0.28"/>
  <arg name="filter_max_height" default="1.18"/>
  <arg name="object_process_min_pitch" default="1.5"/>
  <arg name="semantic_gate_enabled" default="true"/>
  <arg name="semantic_gate_threshold" default="0.45"/>
  <arg name="object_viewpoint_enabled" default="true"/>
  <arg name="object_viewpoint_max_failed_inspections" default="2"/>
  <arg name="object_viewpoint_failure_cooldown_sequences" default="30"/>
  <arg name="object_viewpoint_retry_score_margin" default="0.05"/>
  <arg name="object_viewpoint_failure_spatial_radius" default="0.75"/>

  <group unless="$(arg is_real_world)">
    <rosparam file="$(find exploration_manager)/../../../config/$(arg eval_config)" command="load" />
  </group>

  <!-- main algorithm params -->
  <include file="$(find exploration_manager)/launch/algorithm.xml">
    <!-- Pass real-world flag to exploration node -->
    <arg name="is_real_world_" value="$(arg is_real_world)"/>

    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>

    <arg name="odometry_topic_" value="$(arg odom_topic)"/>
    <arg name="sensor_pose_topic_" value="$(arg sensor_pose_topic)"/>
    <arg name="depth_topic_" value="$(arg depth_topic)"/>

    <arg name="filter_min_height_" value="$(arg filter_min_height)"/>
    <arg name="filter_max_height_" value="$(arg filter_max_height)"/>
    <arg name="object_process_min_pitch_" value="$(arg object_process_min_pitch)"/>
    <arg name="semantic_gate_enabled_" value="$(arg semantic_gate_enabled)"/>
    <arg name="semantic_gate_threshold_" value="$(arg semantic_gate_threshold)"/>
    <arg name="object_viewpoint_enabled_" value="$(arg object_viewpoint_enabled)"/>
    <arg name="object_viewpoint_max_failed_inspections_"
         value="$(arg object_viewpoint_max_failed_inspections)"/>
    <arg name="object_viewpoint_failure_cooldown_sequences_"
         value="$(arg object_viewpoint_failure_cooldown_sequences)"/>
    <arg name="object_viewpoint_retry_score_margin_"
         value="$(arg object_viewpoint_retry_score_margin)"/>
    <arg name="object_viewpoint_failure_spatial_radius_"
         value="$(arg object_viewpoint_failure_spatial_radius)"/>

    <!-- intrinsic params of the depth camera -->
    <arg name="cx_" value="320"/>
    <arg name="cy_" value="240"/>
    <arg name="fx_" value="388.1910413097385"/>
    <arg name="fy_" value="422.0475153598262"/>
  </include>
</launch>
